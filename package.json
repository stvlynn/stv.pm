{
  "name": "stv.pm",
  "version": "0.1.0",
  "private": true,
  "description": "Steven Lynn's personal homepage.",
  "type": "module",
  "scripts": {
    "dev": "next dev frontend",
    "build": "next build frontend",
    "start": "next start frontend",
    "typecheck": "tsc -p frontend --noEmit",
    "lint": "eslint --max-warnings 0 frontend backend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "build:worker": "cd frontend && opennextjs-cloudflare build",
    "deploy:worker": "cd frontend && opennextjs-cloudflare deploy",
    "preview:worker": "cd frontend && opennextjs-cloudflare preview"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "clsx": "2.1.1",
    "geist": "1.7.2",
    "lucide-react": "1.40.0",
    "motion": "13.5.1",
    "next": "16.3.8",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simple-icons": "16.30.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.10",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.8",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "^4.149.0"
  }
}
